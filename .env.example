# Aluxen — variáveis de ambiente da instância.
#
# Toda configuração vem do ambiente (12-factor). Nenhum segredo é versionado:
# este arquivo é o contrato das chaves exigidas.

# ── Aplicação ──────────────────────────────────────────────────────
APP_ENV=development
HOST=0.0.0.0
PORT=3000
TZ=America/Sao_Paulo

# ── Banco ──────────────────────────────────────────────────────────
# file:/data/aluxen.db  → SQLite (padrão)
# postgres://user:pass@host:5432/aluxen → Postgres
DATABASE_URL=
# Usado quando DATABASE_URL está vazia: o banco fica em DB_DIR/aluxen.db
DB_DIR=
# Popula a base com os dados de demonstração no boot (apenas para demo)
SEED_DEMO=false

# ── Segredos ───────────────────────────────────────────────────────
# Assina sessão, CSRF e os tokens de autenticidade dos documentos.
# Obrigatório (>= 16 caracteres) quando APP_ENV=production.
SESSION_SECRET=
# Em produção o cookie é sempre Secure; defina true apenas se servir HTTPS fora de produção.
COOKIE_SECURE=false

# ── Semente do administrador ───────────────────────────────────────
# Obrigatório no primeiro boot. O app exige a troca no primeiro login.
SEED_USERNAME=admin
SEED_PASSWORD=
DEFAULT_LANDLORD_NAME=Locador
DEFAULT_LANDLORD_CPF=

# ── URL pública ────────────────────────────────────────────────────
# Base dos links de validação e dos QR codes impressos nos documentos.
APP_URL=
BASE_URL=

# ── Proteção do login ──────────────────────────────────────────────
RATE_LIMIT_MAX=5
RATE_LIMIT_GLOBAL_MAX=60
LOGIN_LOCK_THRESHOLD=10

# ── Log ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# json (padrão em produção) ou pretty/texto
LOG_FORMAT=

# ── WhatsApp (WAHA) ────────────────────────────────────────────────
# demo  → não-oficial (WAHA), risco de banimento: apenas demonstração
# client → Cloud API oficial da Meta (cliente pagante)
WHATSAPP_MODE=demo
WAHA_API_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Segredo HMAC que valida o webhook de mensagens recebidas
WAHA_WEBHOOK_SECRET=

# ── Extração por IA ────────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
# Confiança mínima para baixa automática; abaixo disso vai para revisão humana
AI_CONFIDENCE_THRESHOLD=0.9

# ── Provisionamento (script de instância) ──────────────────────────
EASYPANEL_URL=
EASYPANEL_API_KEY=
